<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Quill.App"
             xmlns:local="using:Quill"
             xmlns:converters="clr-namespace:Avalonia.Controls.Converters;assembly=Avalonia.Controls"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <converters:EnumToBoolConverter x:Key="EnumToBoolConverter"/>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />
        
        <!-- Window background -->
        <Style Selector="Window">
            <Setter Property="Background" Value="{DynamicResource Color.Background}" />
        </Style>
        
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        </Style>
        
        <Style Selector="Button">
            <Setter Property="Margin" Value="8"/>
            <Setter Property="MinHeight" Value="36"/>
            
            <Setter Property="Background" Value="{DynamicResource Color.Surface}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Color.SurfaceAlt}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            
        </Style>
        
        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="{DynamicResource Color.SurfaceAlt}"/>
            <!-- <Setter Property="BorderBrush" Value="{DynamicResource Color.SurfaceAlt}"/> -->
        </Style>

        <Style Selector="Button:pressed">
            <Setter Property="Background" Value="{DynamicResource Color.Primary}"/>
            <!-- <Setter Property="BorderBrush" Value="#666666"/> -->
        </Style>
        
        <Style Selector="Button:disabled">
            <Setter Property="Background" Value="{DynamicResource Color.Background}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Color.Surface}"/>
            <Setter Property="Opacity" Value="0.6"/>
        </Style>
        
    </Application.Styles>
             
    <Application.Resources>
        
        <!-- Core palette -->
        <SolidColorBrush x:Key="Color.Background">#222831</SolidColorBrush>
        <SolidColorBrush x:Key="Color.Surface">#445061</SolidColorBrush>
        <SolidColorBrush x:Key="Color.SurfaceAlt">#536D90</SolidColorBrush>
        <SolidColorBrush x:Key="Color.Primary">#214068</SolidColorBrush>

        <!-- Text colours -->
        <SolidColorBrush x:Key="Brush.TextPrimary">#FFFFFF</SolidColorBrush>
        <SolidColorBrush x:Key="Brush.TextSecondary">#C7D0DD</SolidColorBrush>
        
        <x:Double x:Key="HeadingSize">24</x:Double>
        <x:Double x:Key="SubheadingSize">18</x:Double>
        <x:Double x:Key="BodySize">14</x:Double>
        
        <Thickness x:Key="DefaultMargin">8</Thickness>
        <Thickness x:Key="PagePadding">16</Thickness>
        
        
    </Application.Resources>
             
</Application>